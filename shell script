1. Arithmetic Operations

#!/bin/bash
perform_operations() {
   echo "Enter two numbers:"
   read num1 num2
   echo "Select operation:"
   echo "1. Addition"
   echo "2. Subtraction"
   echo "3. Multiplication"
   echo "4. Division"
   read operation

   case $operation in
       1) echo "Result: $(($num1 + $num2))" ;;
       2) echo "Result: $(($num1 - $num2))" ;;
       3) echo "Result: $(($num1 * $num2))" ;;
       4) echo "Result: $(($num1 / $num2))" ;;
       *) echo "Invalid operation" ;;
   esac
}
perform_operations



2. Simple Interest Calculation

#!/bin/bash
calculate_interest() {
   echo "Enter principal amount:"
   read principal
   echo "Enter rate of interest (in %):"
   read rate
   echo "Enter time (in years):"
   read time
   interest=$(echo "scale=2; $principal * $rate * $time / 100" | bc)
   echo "Simple Interest: $interest"
}
calculate_interest


3. Largest Among Three Numbers
#!/bin/bash
find_largest() {
   echo "Enter three numbers:"
   read num1 num2 num3
   if [ $num1 -ge $num2 ] && [ $num1 -ge $num3 ]; then
       echo "Largest number is: $num1"
   elif [ $num2 -ge $num1 ] && [ $num2 -ge $num3 ]; then
       echo "Largest number is: $num2"
   else
       echo "Largest number is: $num3"
   fi
}
find_largest


4. Leap Year Check
#!/bin/bash
check_leap_year() {
   echo "Enter a year:"
   read year
   if (( ($year % 4 == 0 && $year % 100 != 0) || ($year % 400 == 0) )); then
       echo "$year is a leap year."
   else
       echo "$year is not a leap year."
   fi
}
check_leap_year


5. Multiplication Table
#!/bin/bash
print_table() {
   echo "Enter a number:"
   read number
   echo "Multiplication Table of $number"
   i=1
   while [ $i -le 10 ]
   do
       echo "$number x $i = $((number * i))"
       i=$((i + 1))
   done
}
print_table


6. Search Element in a List
#!/bin/bash
search_element() {
   echo "Enter the list of elements (space-separated):"
   read -a list
   echo "Enter the element to search:"
   read element

   for item in "${list[@]}"; do
       if [ "$item" == "$element" ]; then
           echo "$element is present in the list."
           return
       fi
   done
   echo "$element is not present in the list."
}
search_element


