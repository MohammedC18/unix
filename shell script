10. Print Pattern
#!/bin/bash
print_pattern() {
   for i in {1..5}
   do
       for j in $(seq 1 $i)
       do
           echo -n "* "
       done
       echo ""
   done
}
print_pattern


11. Directory Operations
#!/bin/bash
directory_operations() {
   echo "Current Directory: $(pwd)"
   echo "Contents of the Directory:"
   ls
   echo "Creating a new directory named 'new_directory'..."
   mkdir -p new_directory
   echo "New directory created."
   echo "Copying contents to the new directory..."
   cp -r * new_directory/
   echo "Contents copied."
}
directory_operations
