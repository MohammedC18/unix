compare_strings


8. Check File/Directory Existence
#!/bin/bash
check_and_create() {
   echo "Enter the directory/file path:"
   read path
   if [ -e "$path" ]; then
       echo "$path exists."
   else
       echo "$path does not exist. Creating..."
       mkdir -p "$path"
       echo "$path created."
   fi
}
check_and_create


